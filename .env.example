# Copy this file to `.env` and adjust values if the defaults don't fit your
# machine. Every variable is optional - if unset, the project falls back to
# paths computed relative to the project root, so it runs out of the box on
# any machine/OS with no source-code changes.

# --- Inference device (scripts/inference/process_video.py, scripts/training/train_yolo.py,
# --- scripts/evaluation/evaluate_models.py, scripts/dataset/auto_annotate_ball.py,
# --- scripts/dataset/auto_annotate_players_heads.py) ---
# Leave unset to auto-detect: CUDA ("0") > Apple MPS > CPU.
# Set explicitly to force one, e.g. "cpu", "mps", or a CUDA device index "0".
# DEVICE=

# --- Trained detector weights used by the webapp pipeline ---
# Path is relative to the project root unless absolute.
# MODEL_PATH=models/checkpoints/yolov8m/best.pt

# --- Webapp job/upload storage (relative to the project root unless absolute) ---
# JOBS_DIR=webapp/jobs
# UPLOADS_DIR=webapp/uploads

# --- Webapp SQLite database (relative to the project root unless absolute) ---
# DB_PATH=webapp/headtrack.db

# --- Webapp server bind address (used only when running `python app.py` directly;
# --- the documented `uvicorn app:app --reload` command takes --host/--port instead) ---
# WEBAPP_HOST=127.0.0.1
# WEBAPP_PORT=8000
# WEBAPP_RELOAD=false

# --- LLM report generation (scripts/llm_reporting/generate_reports.py), via Ollama running locally ---
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b
